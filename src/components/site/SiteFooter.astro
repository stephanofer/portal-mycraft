---
import SiteBrand from "@/components/site/SiteBrand.astro";
import SocialIcon from "@/components/ui/SocialIcon.astro";
import { site } from "@/lib/site";

const navigation = [
    { label: "Inicio", href: "/" },
    { label: "Cómo jugar", href: "/#como-jugar" },
    { label: "Comunidad", href: "/#comunidad" },
    { label: "Tienda", href: "/#tienda" },
];
---

<footer class="border-t border-white/8 bg-surface/45">
    <div class="mx-auto max-w-7xl px-5 pt-14 sm:px-8 sm:pt-18">
        <div class="grid gap-12 border-b border-white/8 pb-12 sm:pb-14 lg:grid-cols-[1.15fr_0.7fr_1.15fr] lg:gap-16">
            <div class="flex flex-col items-center text-center lg:items-start lg:text-left">
                <SiteBrand />
                <p class="mt-4 max-w-82 text-sm leading-6 text-muted">
                    Un mundo para explorar, competir y construir historias junto a una comunidad que nunca deja de crecer.
                </p>
            </div>

            <nav class="text-center lg:text-left" aria-label="Navegación del pie de página">
                <p class="text-xs font-semibold tracking-[0.16em] text-white uppercase">Explora</p>
                <ul class="mx-auto mt-5 grid max-w-64 grid-cols-2 gap-x-5 gap-y-3 text-sm text-muted lg:mx-0 lg:grid-cols-1">
                    {navigation.map(({ label, href }) => (
                        <li>
                            <a
                                href={href}
                                class="inline-flex min-h-8 w-full items-center justify-center transition-colors duration-150 hover:text-white motion-reduce:transition-none lg:w-auto lg:justify-start"
                            >
                                {label}
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>

            <div class="text-center lg:text-left">
                <p class="text-xs font-semibold tracking-[0.16em] text-white uppercase">Entra a Mycraft</p>
                <p class="mt-3 text-sm leading-6 text-muted">Copia la IP y comienza tu aventura en segundos.</p>
                <div class="mx-auto mt-5 flex max-w-72 justify-center lg:mx-0 lg:justify-start">
                    <slot name="server-controls" />
                </div>
            </div>
        </div>

        <div class="flex flex-col items-center gap-7 py-7 text-center lg:flex-row lg:justify-between lg:text-left">
            <div>
                <p class="text-xs font-semibold tracking-[0.16em] text-white uppercase">Síguenos</p>
                <ul class="mt-4 flex flex-wrap justify-center gap-2 lg:justify-start" aria-label="Redes sociales">
                    {site.socials.map(({ name, network, url }) => (
                        <li>
                            <a
                                href={url}
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label={`${name} de Mycraft (se abre en otra pestaña)`}
                                class="grid size-11 place-items-center rounded-xl border border-white/12 bg-white/6 text-muted transition-[color,background-color,border-color,transform] duration-150 hover:-translate-y-0.5 hover:border-accent/60 hover:bg-accent hover:text-canvas motion-reduce:transform-none motion-reduce:transition-none"
                            >
                                <SocialIcon network={network} class="size-5" />
                            </a>
                        </li>
                    ))}
                </ul>
            </div>

            <div class="text-xs leading-5 text-muted lg:text-right">
                <p>© {new Date().getFullYear()} {site.name}</p>
                <p>Hecho para jugar. Construido para compartir.</p>
            </div>
        </div>
    </div>
</footer>
