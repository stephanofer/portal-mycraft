---
import { server } from '@/features/play/data/server';
import ServerAddressButton from '@/features/play/components/ServerAddressButton.astro';
---

<section id="como-jugar" aria-labelledby="join-title" class="mx-auto max-w-7xl scroll-mt-8 px-5 py-14 sm:px-8 sm:py-20">
  <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
    <div>
      <p class="text-[0.65rem] font-medium tracking-[0.18em] text-accent uppercase">Nos vemos dentro</p>
      <h2 id="join-title" class="mt-3 font-display text-3xl font-medium tracking-tight sm:text-4xl">Tu primer bloque empieza aquí.</h2>
    </div>
    <p class="inline-flex w-fit items-center gap-2 rounded-full border border-white/10 px-3 py-2 text-xs text-muted"><span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>{server.editionLabel}<span class="text-white/25" aria-hidden="true">/</span>{server.supportedVersions}</p>
  </div>

  <ol class="mt-9 grid gap-7 sm:grid-cols-3 sm:gap-8">
    <li class="border-t border-white/12 pt-5">
      <span class="font-display text-sm font-medium text-accent" aria-hidden="true">01 /</span>
      <h3 class="mt-3 text-base font-medium text-white">Abre Minecraft</h3>
      <p class="mt-2 max-w-85 text-sm leading-7 text-muted">Usa {server.editionLabel} en una versión compatible y entra en <span class="text-white/85">Multijugador</span>.</p>
    </li>
    <li class="border-t border-white/12 pt-5">
      <span class="font-display text-sm font-medium text-accent" aria-hidden="true">02 /</span>
      <h3 class="mt-3 text-base font-medium text-white">Añade nuestro servidor</h3>
      <p class="mt-2 max-w-85 text-sm leading-7 text-muted">Selecciona <span class="text-white/85">Añadir servidor</span> y pega esta dirección en el campo correspondiente.</p>
      <div class="mt-4"><ServerAddressButton compact /></div>
      <noscript><p class="mt-3 text-xs text-muted">Copia manualmente esta dirección: <span class="select-all text-white">{server.address}</span></p></noscript>
    </li>
    <li class="border-t border-white/12 pt-5">
      <span class="font-display text-sm font-medium text-accent" aria-hidden="true">03 /</span>
      <h3 class="mt-3 text-base font-medium text-white">Hazlo tu mundo</h3>
      <p class="mt-2 max-w-85 text-sm leading-7 text-muted">Guarda el servidor, pulsa <span class="text-white/85">Entrar al servidor</span> y empieza a escribir tu historia con nosotros.</p>
    </li>
  </ol>
</section>
