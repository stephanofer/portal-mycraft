---
import { Image } from "astro:assets";
import discordImage from "@/assets/discord.webp";
import DiscordLogo from "@/assets/icons/discord-logo.svg";
import Icon from "@/components/ui/Icon.astro";
import { site } from "@/lib/site";
---

<section
    id="comunidad"
    aria-labelledby="community-title"
    class="relative isolate scroll-mt-8 overflow-hidden border-y border-white/6"
>
    <div
        class="pointer-events-none absolute top-1/2 left-[15%] -z-10 size-80 -translate-y-1/2 rounded-full bg-discord/14 blur-3xl"
        aria-hidden="true"
    ></div>
    <div class="mx-auto grid max-w-7xl items-center gap-8 px-5 py-18 sm:px-8 sm:py-24 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16 lg:py-28">
        <div class="relative mx-auto w-full max-w-108 lg:mx-0">
            <div
                class="absolute inset-x-14 bottom-5 h-14 rounded-full bg-discord/25 blur-2xl"
                aria-hidden="true"
            ></div>
            <Image
                src={discordImage}
                alt="Mascota robótica de Mycraft saludando junto al símbolo de Discord"
                widths={[360, 520, 720]}
                sizes="(min-width: 1024px) 432px, min(85vw, 432px)"
                quality={85}
                class="relative w-full drop-shadow-[0_28px_45px_rgb(0_0_0/0.35)] transition-transform duration-300 ease-out motion-safe:hover:-translate-y-1 motion-reduce:transition-none"
            />
        </div>

        <div class="mx-auto max-w-140 text-center lg:mx-0 lg:justify-self-end lg:text-left">
            <h2
                id="community-title"
                class="mt-5 font-display text-3xl leading-[1.08] font-medium tracking-tight text-white sm:text-4xl lg:text-5xl"
            >
                Comunidad oficial
            </h2>
            <p class="mx-auto mt-5 max-w-128 text-base leading-7 text-muted sm:text-lg sm:leading-8 lg:mx-0">
                Conoce jugadores, encuentra equipo y entérate antes que nadie de
                eventos, novedades y actualizaciones de Mycraft.
            </p>
            <a
                href={site.discordUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="group mt-8 inline-flex min-h-13 items-center gap-3 rounded-xl border border-discord/70 bg-discord px-6 text-sm font-semibold text-white shadow-lg shadow-discord/10 transition-[background-color,box-shadow,transform] duration-200 hover:-translate-y-0.5 hover:bg-discord/85 hover:shadow-discord/20 motion-reduce:transform-none motion-reduce:transition-none"
            >
                <DiscordLogo
                    class="size-5"
                    fill="currentColor"
                    aria-hidden="true"
                />
                Unirme a Discord
                <Icon
                    name="arrow-up-right"
                    class="size-4 transition-transform duration-150 motion-safe:group-hover:translate-x-0.5 motion-safe:group-hover:-translate-y-0.5 motion-reduce:transition-none"
                />
                <span class="sr-only"> (se abre en otra pestaña)</span>
            </a>
        </div>
    </div>
</section>
